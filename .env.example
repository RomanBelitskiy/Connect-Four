# Скопіюй цей файл як .env і заповни значення:
# cp .env.example .env

# Токен Telegram-бота (отримай у @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# URL Web App (без trailing slash) — той самий origin, що відкриває Telegram:
#   BotFather → Bot Settings → Menu Button → Web App URL
#   BotFather → Bot Settings → Main Mini App URL
#   = WEBAPP_URL (кнопки бота ведуть через t.me/...?startapp → той самий Main Mini App)
WEBAPP_URL=https://quopnft.uk

# Username бота (опційно — підтягується з API при старті)
BOT_USERNAME=Minigameshubot

# Якщо Menu відкривається «віконцем», а ▶ Грати — нормально: майже завжди Menu URL ≠ Main Mini App
# або сторінка без expand/requestFullscreen (у index.html — одразу після telegram-web-app.js).

# Порт сервера (за замовчуванням 3000)
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://connect_four_user:your_password@localhost:5432/connect_four
